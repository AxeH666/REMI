# Copy this file to .env.local and replace every placeholder.
# Never commit .env.local.
# Create a new Gemini key. Do not reuse a key that may have been exposed.
GEMINI_API_KEY=replace_with_a_new_key
GEMINI_MODEL=gemini-3.7-flash
MAX_VIDEO_MB=100

# Private POC accounts use the fixed usernames "owner" and "friend".
# Give each account a different password of 24-128 non-space printable ASCII characters.
REMI_OWNER_PASSWORD=replace_with_a_unique_random_owner_password
REMI_FRIEND_PASSWORD=replace_with_a_unique_random_friend_password
